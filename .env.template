#!/usr/bin/env bash

export RUSTC_BOOTSTRAP=1

export COMPLEMENT_DIR=../complement
# Optional Complement checkout selection.
#export COMPLEMENT_REF=main
#export COMPLEMENT_REPO=matrix-org/complement

# Complement execution and cleanup.
export COMPLEMENT_ENABLE_DIRTY_RUNS=1
# Remove stale Complement containers and networks before starting a run.
export COMPLEMENT_CLEANUP_STALE_RESOURCES=1
export COMPLEMENT_STALE_NETWORK_AGE_SECS=600
export COMPLEMENT_PARALLEL=2
#export COMPLEMENT_RUN=TestMSC4297StateResolutionV2_1
#export COMPLEMENT_NO_BLACKLIST=1
#export COMPLEMENT_SPAWN_HS_TIMEOUT_SECS=30

# Set this when using Podman instead of Docker.
#export CONTAINER_RUNTIME=podman

# Worker and reactor modes. Leave commented for the default monolith run.
#export WORKERS=1
#export WORKER_TYPES=
#export ASYNCIO_REACTOR=1
#export UNIX_SOCKETS=1

export SYNAPSE_POSTGRES=1
export SYNAPSE_PG_TIMINGS=1
export SYNAPSE_TEST_MTXDB=1
# Optional test database/runtime settings.
#export SYNAPSE_TEST_POSTGRES=1
#export POSTGRES=1
#export SYNAPSE_TEST_LOG_LEVEL=INFO

# mtxdb behavior toggles.
# Complement defaults WAL on when mtxdb is enabled. Override it only for a
# test run with the TEST_-scoped variable below.
#export SYNAPSE_TEST_MTXDB_WAL=0
# If the writer has WAL enabled, workers must also enable WAL or they refuse to
# start rather than silently serving stale checkpointed state. This explicit
# diagnostic override permits snapshot-only workers instead.
#export SYNAPSE_TEST_MTXDB_SNAPSHOT_WORKERS=1
# Print mtxdb runtime, FFI, and sync timing diagnostics at process exit.
#export SYNAPSE_MTXDB_STATS=1
# Complement also accepts this test-scoped spelling.
#export SYNAPSE_TEST_MTXDB_STATS=1
# Complement deliberately ignores the production no-sync variable. Use this
# test-only switch to disable WAL sync/fsync inside Complement containers.
#export SYNAPSE_TEST_MTXDB_NO_SYNC=1
# Repack all opened mtxdb collections after each HomeserverTestCase. This is
# a diagnostic test-only control and can make the suite substantially slower.
#export SYNAPSE_TEST_MTXDB_REPACK_BETWEEN_TESTS=1

#export SYNAPSE_TEST_EMBEDDED_HAMT_ENGINE=mtxdb
export SYNAPSE_TEST_EMBEDDED_HAMT_PATH=.tmp/mtxdb-test

# Keep each Complement container's mtxdb store on a host directory instead of
# Docker's overlay. One subdirectory per container; never cleaned up.
#export COMPLEMENT_MTXDB_HOST_DIR=/path/to/large/disk/.mtxdb-complement
