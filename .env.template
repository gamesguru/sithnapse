#!/usr/bin/env bash

RUSTC_BOOTSTRAP=1

COMPLEMENT_DIR=../complement
# Optional Complement checkout selection.
#COMPLEMENT_REF=main
#COMPLEMENT_REPO=matrix-org/complement

# Complement execution and cleanup.
COMPLEMENT_ENABLE_DIRTY_RUNS=1
# Remove stale Complement containers and networks before starting a run.
COMPLEMENT_CLEANUP_STALE_RESOURCES=1
COMPLEMENT_STALE_NETWORK_AGE_SECS=600
COMPLEMENT_PARALLEL=2
#COMPLEMENT_RUN=TestMSC4297StateResolutionV2_1
#COMPLEMENT_NO_BLACKLIST=1
#COMPLEMENT_SPAWN_HS_TIMEOUT_SECS=30

# Set this when using Podman instead of Docker.
#CONTAINER_RUNTIME=podman

# Worker and reactor modes. Leave commented for the default monolith run.
#WORKERS=1
#WORKER_TYPES=
#ASYNCIO_REACTOR=1
#UNIX_SOCKETS=1

SYNAPSE_POSTGRES=1
SYNAPSE_PG_TIMINGS=1
SYNAPSE_TEST_MTXDB=1
# Optional test database/runtime settings.
#SYNAPSE_TEST_POSTGRES=1
#POSTGRES=1
#SYNAPSE_TEST_LOG_LEVEL=INFO

# mtxdb behavior toggles.
#SYNAPSE_MTXDB_WAL=1
# Print mtxdb runtime, FFI, and sync timing diagnostics at process exit.
#SYNAPSE_MTXDB_STATS=1
# Complement also accepts this test-scoped spelling.
#SYNAPSE_TEST_MTXDB_STATS=1
#SYNAPSE_MTXDB_NO_SYNC=1
# Repack all opened mtxdb collections after each HomeserverTestCase. This is
# a diagnostic test-only control and can make the suite substantially slower.
#SYNAPSE_TEST_MTXDB_REPACK_BETWEEN_TESTS=1

#SYNAPSE_TEST_EMBEDDED_HAMT_ENGINE=mtxdb
SYNAPSE_TEST_EMBEDDED_HAMT_PATH=.tmp/mtxdb-test
