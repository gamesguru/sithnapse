-- SQLite cannot alter a primary key in place. This migration runs after the
-- content column and sticky_duration_ms column migrations, so preserve their
-- current shape while rebuilding the table with delay_id as the primary key.
DELETE FROM delayed_events WHERE rowid IN (
    SELECT rowid FROM (
        SELECT rowid,
               ROW_NUMBER() OVER (
                   PARTITION BY delay_id
                   ORDER BY is_processed ASC, send_ts DESC, rowid DESC
               ) AS rn
        FROM delayed_events
    ) duplicates
    WHERE rn > 1
);

CREATE TABLE delayed_events_new (
    delay_id TEXT NOT NULL PRIMARY KEY,
    user_localpart TEXT NOT NULL,
    device_id TEXT,
    delay BIGINT NOT NULL,
    send_ts BIGINT NOT NULL,
    room_id TEXT NOT NULL,
    event_type TEXT NOT NULL,
    state_key TEXT,
    origin_server_ts BIGINT,
    content TEXT NOT NULL,
    is_processed BOOLEAN NOT NULL DEFAULT FALSE,
    sticky_duration_ms BIGINT
);

INSERT INTO delayed_events_new (
    delay_id, user_localpart, device_id, delay, send_ts, room_id, event_type,
    state_key, origin_server_ts, content, is_processed, sticky_duration_ms
)
SELECT
    delay_id, user_localpart, device_id, delay, send_ts, room_id, event_type,
    state_key, origin_server_ts, content, is_processed, sticky_duration_ms
FROM delayed_events;

DROP TABLE delayed_events;
ALTER TABLE delayed_events_new RENAME TO delayed_events;

