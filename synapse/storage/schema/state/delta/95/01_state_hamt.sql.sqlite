CREATE TABLE IF NOT EXISTS state_hamt_nodes (
    structural_hash BLOB PRIMARY KEY,
    node_bytes BLOB NOT NULL
);

CREATE TABLE IF NOT EXISTS state_hamt_roots (
    state_group BIGINT PRIMARY KEY,
    room_prefix BLOB NOT NULL,
    root_structural_hash BLOB NOT NULL,
    -- See the .postgres delta for the rationale: the retained LtHash
    -- lattice, distinct from the collapsed state_group_id digest, needed
    -- to apply a later incremental update against this root.
    root_lattice BLOB,
    published BOOLEAN NOT NULL DEFAULT 1
);

CREATE TABLE IF NOT EXISTS state_hamt_pending_nodes (
    structural_hash BLOB PRIMARY KEY,
    node_bytes BLOB NOT NULL
);
