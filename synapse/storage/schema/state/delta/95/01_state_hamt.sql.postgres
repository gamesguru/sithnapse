CREATE TABLE IF NOT EXISTS state_hamt_nodes (
    structural_hash BYTEA PRIMARY KEY,
    node_bytes BYTEA NOT NULL
);

CREATE TABLE IF NOT EXISTS state_hamt_roots (
    state_group BIGINT PRIMARY KEY,
    room_prefix BYTEA NOT NULL,
    root_structural_hash BYTEA NOT NULL,
    -- The retained 2048-byte LtHash lattice for this root (see
    -- lattice_to_bytes/lattice_from_bytes in rust/src/state_hamt.rs) --
    -- distinct from the root's collapsed state_group_id digest, which
    -- can't be "un-collapsed" back into something apply_flat_state_updates
    -- can incrementally update from. Both write paths (full rebuild and
    -- incremental update) populate this going forward, so any root can
    -- serve as the base for a later incremental update. Nullable only to
    -- tolerate a row written before this column existed; NULL means "no
    -- usable base for an incremental update from this root", not an error.
    root_lattice BYTEA,
    published BOOLEAN NOT NULL DEFAULT TRUE
);

CREATE TABLE IF NOT EXISTS state_hamt_pending_nodes (
    structural_hash BYTEA PRIMARY KEY,
    node_bytes BYTEA NOT NULL
);
